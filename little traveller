        name: "Vietnam", native: "VIỆT NAM",
        from: "HANOI (HAN)", flight: "VN 0824",
        flag: "🇻🇳", emoji: "🛶", city: "Hanoi",
        greeting: "CHÚC BẠN MỘT CHUYẾN ĐI TỐT ĐẸP!",
        img: "images/vietnam.png",
        traits: { culture: 70, nature: 75, urban: 45, wellness: 55, adventure: 85 }
    },
    russia: {
        name: "Russia", native: "РОССИЯ",
        from: "MOSCOW (SVO)", flight: "SU 0724",
        flag: "🇷🇺", emoji: "⛪", city: "St. Petersburg",
        greeting: "СЧАСТЛИВОГО ПУТИ! HAVE A SAFE FLIGHT!",
        img: "images/russia.png",
        traits: { culture: 88, nature: 55, urban: 65, wellness: 40, adventure: 60 }
    }
};

// ═══════════ STATE ═══════════
let cur = 0, ans = [], scores = {};

function initScores() {
    scores = { japan: 0, hongkong: 0, philippines: 0, indonesia: 0, india: 0, china: 0, vietnam: 0, russia: 0 };
}

// ═══════════ PAGE NAV ═══════════
function showPage(id) {
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function startQuiz() {
    initScores(); ans = []; cur = 0;
    showPage('quiz');
    renderQ();
}

// ═══════════ RENDER QUESTION ═══════════
function renderQ() {
    const q = questions[cur];
    const total = questions.length;

    document.getElementById('qCurrent').textContent = cur + 1;
    document.getElementById('qNum').textContent = 'Question ' + String(cur + 1).padStart(2, '0');
    document.getElementById('qText').textContent = q.text;
    document.getElementById('progFill').style.width = ((cur + 1) / total * 100) + '%';

    const box = document.getElementById('optsBox');
    box.innerHTML = '';
    q.opts.forEach((o, i) => {
        const btn = document.createElement('button');
        btn.className = 'opt-btn' + (ans[cur] === i ? ' selected' : '');
        btn.innerHTML = `<span class="opt-ico">${o.ico}</span><span>${o.t}</span>`;
        btn.onclick = () => selectOpt(i);
        box.appendChild(btn);
    });

    document.getElementById('btnBack').style.visibility = cur === 0 ? 'hidden' : 'visible';
    const nextBtn = document.getElementById('btnNext');
    nextBtn.textContent = cur === total - 1 ? '🎉 See My Results' : 'Next →';
    nextBtn.disabled = ans[cur] === undefined;

    const hints = [
        "🧳 No wrong answers — follow your heart!",
        "✨ Think about your dream trip...",
        "🌏 Where does your soul want to go?",
        "🎒 Halfway there — keep going!",
        "⭐ You're on fire! Almost done.",
        "🗺️ Just a few more questions...",
        "✈️ Preparing your boarding pass...",
        "🌸 Great taste — we love it!",
        "🎉 One more to go!",
        "🚀 Last one — make it count!"
    ];
    document.getElementById('qHint').textContent = hints[cur] || hints[0];
}

function selectOpt(i) {
    ans[cur] = i;
    document.querySelectorAll('.opt-btn').forEach((b, j) => b.classList.toggle('selected', j === i));
    document.getElementById('btnNext').disabled = false;
}

function goNext() {
    if (ans[cur] === undefined) return;
    if (cur === questions.length - 1) {
        calcScores();
        showPage('result');
        showResult();
        return;
    }
    cur++;
    renderQ();
}

function goPrev() {
    if (cur > 0) { cur--; renderQ(); }
}

// ═══════════ CALCULATE SCORES ═══════════
function calcScores() {
    initScores();
    questions.forEach((q, qi) => {
        if (ans[qi] !== undefined) {
            Object.entries(q.opts[ans[qi]].sc).forEach(([c, pts]) => {
                scores[c] += pts;
            });
        }
    });
}

// ═══════════ SHOW RESULT ═══════════
function showResult() {
    const sorted = Object.entries(scores).sort((a, b) => b[1] - a[1]);
    const t1 = countries[sorted[0][0]];
    const t2 = countries[sorted[1][0]];
    const t3 = countries[sorted[2][0]];

    // Normalise to 75–98% range
    const maxRaw = sorted[0][1];
    const pct = (raw) => Math.min(Math.round(75 + (raw / Math.max(maxRaw, 1)) * 23), 98);
    const s1 = pct(sorted[0][1]);
    const s2 = pct(sorted[1][1]);
    const s3 = pct(sorted[2][1]);

    // ── Boarding Pass ──
    document.getElementById('bpNative').textContent = t1.native;
    document.getElementById('bpCountryEn').textContent = t1.name.toUpperCase();

    // Character image — set src, let onload/onerror handle visibility
    const charImg = document.getElementById('bpCharImg');
    const charEmoji = document.getElementById('bpCharEmoji');
    charImg.style.display = 'none';
    charEmoji.style.display = 'block';
    charEmoji.textContent = t1.emoji;
    charImg.src = '';          // reset
    charImg.src = t1.img;      // trigger load attempt

    document.getElementById('bpFlight').textContent = t1.flight;
    document.getElementById('bpFrom').textContent = t1.from;
    document.getElementById('bpMatchText').textContent = s1 + '% MATCH';
    document.getElementById('bpStubFrom').textContent = t1.from;
    document.getElementById('bpStubFlight').textContent = t1.flight;
    document.getElementById('bpStampText').textContent = t1.name.toUpperCase();
    document.getElementById('bpGreeting').textContent = t1.greeting;

    // Re-trigger stamp animation
    const stamp = document.getElementById('bpStamp');
    stamp.style.animation = 'none';
    stamp.style.opacity = '0';
    stamp.style.transform = 'scale(0) rotate(-8deg)';
    requestAnimationFrame(() => {
        requestAnimationFrame(() => {
            stamp.style.animation = 'stampPop 0.5s cubic-bezier(0.34,1.56,0.64,1) 1.2s both';
        });
    });

    // ── 2nd destination ──
    setDestCard('d2', t2, s2);
    // ── 3rd destination ──
    setDestCard('d3', t3, s3);

    // ── Travel DNA ──
    const tr = t1.traits;
    setTimeout(() => {
        setBar('barCulture', 'pctCulture', tr.culture);
        setBar('barNature', 'pctNature', tr.nature);
        setBar('barUrban', 'pctUrban', tr.urban);
        setBar('barWellness', 'pctWellness', tr.wellness);
        setBar('barAdventure', 'pctAdventure', tr.adventure);
    }, 700);

    // Confetti!
    launchConfetti();
}

function setDestCard(prefix, country, score) {
    // Image with emoji fallback
    const img = document.getElementById(prefix + 'Img');
    const emo = document.getElementById(prefix + 'Emoji');
    img.style.display = 'none';
    emo.style.display = 'block';
    emo.textContent = country.emoji;
    img.src = '';
    img.src = country.img;

    document.getElementById(prefix + 'Flag').textContent = country.flag;
    document.getElementById(prefix + 'Name').textContent = country.name;
    document.getElementById(prefix + 'Score').textContent = score + '% Match';
    document.getElementById(prefix + 'City').textContent = 'Highlight: ' + country.city;
}

function setBar(barId, pctId, val) {
    document.getElementById(barId).style.width = val + '%';
    document.getElementById(pctId).textContent = val + '%';
}

// ═══════════ CONFETTI ═══════════
function launchConfetti() {
    const box = document.getElementById('confettiBox');
    box.innerHTML = '';
    const colors = ['#355DA8', '#a8c7ff', '#f0c75e', '#ff8585', '#7ecec4', '#F6F0E6', '#ffb347'];
    for (let i = 0; i < 60; i++) {
        const p = document.createElement('div');
        p.className = 'confetti-p';
        p.style.cssText = `
            left: ${Math.random() * 100}%;
            background: ${colors[Math.floor(Math.random() * colors.length)]};
            width: ${Math.random() * 9 + 5}px;
            height: ${Math.random() * 9 + 5}px;
            border-radius: ${Math.random() > 0.5 ? '50%' : '2px'};
            animation-delay: ${Math.random() * 2.5}s;
            animation-duration: ${Math.random() * 2 + 2.5}s;
        `;
        box.appendChild(p);
    }
    setTimeout(() => box.innerHTML = '', 6000);
}

// ═══════════ ACTIONS ═══════════
function shareResult() {
    const text = '✈️ I just discovered my travel soul with Little Traveler! Take the quiz!';
    if (navigator.share) {
        navigator.share({ title: 'Little Traveler', text, url: location.href });
    } else {
        navigator.clipboard.writeText(text + ' ' + location.href)
            .then(() => alert('📋 Link copied to clipboard!'));
    }
}

function retake() { startQuiz(); }
</script>
